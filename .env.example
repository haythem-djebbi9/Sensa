# Copiez ce fichier en .env puis adaptez les valeurs. Sans .env, Sensa tourne en mode local
# (SQLite, stockage disque, tâches Celery exécutées dans le serveur, replis IA locaux).

DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- IA ---------------------------------------------------------------------
# Ordre des fournisseurs (les non configurés sont ignorés)
SENSA_AI_PROVIDERS=groq,claude
# Groq : Whisper (transcription), gpt-oss (texte), Qwen (vision)
GROQ_API_KEY=your_groq_api_key_here
SENSA_GROQ_TEXT_MODEL=openai/gpt-oss-120b
SENSA_GROQ_VISION_MODEL=qwen/qwen3.8-27b
SENSA_GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Claude : description d'image, ton des commentaires, tags, toxicité
ANTHROPIC_API_KEY=
SENSA_CLAUDE_MODEL=claude-opus-5-5
# Whisper : transcription audio (API OpenAI ; repli local si faster-whisper est installé)
OPENAI_API_KEY=
SENSA_WHISPER_LOCAL_MODEL=base
# Modèles open source locaux (requirements-ai-local.txt)
SENSA_USE_LOCAL_MODELS=1

# --- PostgreSQL 16 (laisser vide pour SQLite) ---------------------------------
POSTGRES_DB=
POSTGRES_USER=sensa
POSTGRES_PASSWORD=sensa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis : broker Celery + couche Channels (laisser vide = mode local) -----
REDIS_URL=
# Sans Redis : exécuter les tâches IA dans un thread local (1) ou dans la requête (0)
SENSA_ASYNC_DEV=1

# --- MinIO / S3 pour les images et audios ------------------------------------
USE_MINIO=0
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=sensa-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- E-mails (console par défaut) --------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Sensa <no-reply@sensa.local>
